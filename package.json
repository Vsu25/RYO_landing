  "type": "module",
  "scripts": {
    "dev": "node scripts/local-menu-media.mjs prepare && next dev",
    "prebuild": "node scripts/local-menu-media.mjs clean",
    "build": "next build",
    "preview": "python3 -m http.server 4173 --directory out",
